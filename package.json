{
  "name": "portfolio-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run content:check && next build",
    "lint": "eslint .",
    "preview": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx --conditions=react-server scripts/validate-content.ts && tsx scripts/font-characters.ts --check",
    "fonts:check": "node scripts/check-font-budget.mjs",
    "fonts:characters": "tsx scripts/font-characters.ts",
    "dev:next": "next dev",
    "build:next": "pnpm run content:check && next build",
    "start:next": "next start",
    "test:e2e": "playwright test",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.next.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "gray-matter": "4.0.3",
    "next": "16.4.0",
    "next-mdx-remote": "6.0.0",
    "openai": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "resend": "^6.6.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "framer-motion": "^12.23.26",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.4"
  }
}
